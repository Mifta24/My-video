  {
   "id": "s01",
   "clips": [
    {
     "id": "s01_01",
     "text": "Katanya bakteri di tubuhmu 10 kali lebih banyak dari selmu."
    },
    {
     "id": "s01_02",
     "text": "Itu keliru."
    }
   ]
  },
  {
   "id": "s02",
   "clips": [
    {
     "id": "s02_01",
     "text": "Satu lembar, satu cerita."
    }
   ]
  },
  {
   "id": "s03",
   "clips": [
    {
     "id": "s03_01",
     "text": "Angka sepuluh banding satu itu berasal dari perkiraan kasar, yang diulang terus selama puluhan tahun."
    }
   ]
  },
  {
   "id": "s04",
   "clips": [
    {
     "id": "s04_01",
     "text": "Ambil contoh pria dewasa rata-rata."
    },
    {
     "id": "s04_02",
     "text": "Para peneliti menghitung ulang jumlahnya."
    }
   ]
  },
  {
   "id": "s05",
   "clips": [
    {
     "id": "s05_01",
     "text": "Hasilnya, sekitar 38 triliun bakteri."
    },
    {
     "id": "s05_02",
     "text": "Dan sekitar 30 triliun sel manusia."
    },
    {
     "id": "s05_03",
     "text": "Hampir sama banyak."
    },
    {
     "id": "s05_04",
     "text": "Kira-kira satu banding satu, bukan sepuluh banding satu."
    }
   ]
  },
  {
   "id": "s06",
   "clips": [
    {
     "id": "s06_01",
     "text": "Kenapa angka lama terlalu besar?"
    },
    {
     "id": "s06_02",
     "text": "Perkiraan kasar tahun 1972 menganggap bakteri tersebar di seluruh saluran cerna."
    },
    {
     "id": "s06_03",
     "text": "Padahal sebagian besar ada di usus besar, dengan kepadatan yang terukur lebih rendah."
    }
   ]
  },
  {
   "id": "s07",
   "clips": [
    {
     "id": "s07_01",
     "text": "Menariknya, kalau hanya dibandingkan dengan sel berinti, hasilnya memang sekitar sepuluh banding satu."
    },
    {
     "id": "s07_02",
     "text": "Tapi sekitar sembilan puluh persen sel manusia tidak berinti, terutama sel darah merah."
    }
   ]
  },
  {
   "id": "s08",
   "clips": [
    {
     "id": "s08_01",
     "text": "Soal bobot, seluruh bakteri itu hanya sekitar nol koma dua kilogram."
    }
   ]
  },
  {
   "id": "s09",
   "clips": [
    {
     "id": "s09_01",
     "text": "Tentu ini perkiraan."
    },
    {
     "id": "s09_02",
     "text": "Ketidakpastiannya sekitar dua puluh lima persen, dan angka tiap orang bisa sangat berbeda."
    }
   ]
  },
  {
   "id": "s10",
   "clips": [
    {
     "id": "s10_01",
     "text": "Kadang, angka yang sering diulang itu cuma belum dihitung ulang."
    },
    {
     "id": "s10_02",
     "text": "Kini hitungannya sudah diperbarui."
    }
   ]
  },
